// =========================================================================
// PAYMENTS DOMAIN
//
// Owns money movement and gateway reconciliation. Server-authoritative: a
// browser-reported success is never the final word.
// =========================================================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------
// Payment & Transactions
// ---------------------------------------------------------
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  razorpayOrderId   String?       @unique // Razorpay order_id
  razorpayPaymentId String?       @unique // Razorpay payment_id
  razorpaySignature String?
  amountCents       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String? // card, upi, netbanking, wallet, cod, CASH, CARD, UPI
  /**
   * The instrument in the customer's words — "HDFC Bank •••• 4242",
   * "ananya@okicici", "Net banking · ICICI".
   * `method` says the KIND of payment; this says which one. A gateway order
   * that only ever reads "Card / UPI online" is useless when reconciling a
   * statement or answering "how did they pay?", and the gateway already knows
   * — it is on the payment entity, so it is fetched once at verification and
   * frozen here rather than looked up again later.
   */
  instrumentDetail  String?
  errorCode         String?
  errorDescription  String?
  // Free-form payment reference for non-gateway methods (UPI txn id, card
  // approval code, cheque number). Gateway payments use the razorpay* fields.
  reference         String?
  // Who paid, and the bank's reference for it.
  //
  // A plain upi:// QR cannot supply these — the money reaches the merchant's
  // UPI app and this system never hears about it, so they are entered by the
  // cashier from the customer's confirmation screen. A Razorpay QR fills them
  // automatically from its webhook. Either way they belong on the invoice,
  // because "paid by UPI" without a reference is not reconcilable.
  payerVpa          String?
  /**
   * UPI RRN / UTR — the 12-digit bank reference for the transfer.
   */
  utr               String?
  /// Money sent back to the client, recorded by staff when they refund
  /// (the shop refunds by hand — nothing here calls a payment gateway).
  refundedCents     Int?
  refundedAt        DateTime?
  refundMethod      String? // UPI, CARD, CASH, BANK_TRANSFER, ORIGINAL
  refundReference   String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------
// Payment links & QR codes
// ---------------------------------------------------------
enum PaymentLinkKind {
  LINK // a hosted Razorpay payment page, sent to the client
  QR // a single-use UPI QR, shown on a screen
}

enum PaymentLinkStatus {
  CREATED
  PAID
  EXPIRED
  CANCELLED
}

/**
 * A way of collecting an order's payment outside the storefront checkout: a
 * link the client opens on their phone, or a UPI QR shown at the counter.
 * Always fixed to one order and its exact amount — the client cannot change
 * what they pay. The gateway tells us when it is paid (see the webhook); this
 * row is what lets staff see what was sent, cancel it, and send another.
 */
model PaymentLink {
  id          String            @id @default(cuid())
  orderId     String
  kind        PaymentLinkKind
  // Razorpay's id: plink_… for a link, qr_… for a QR.
  gatewayId   String            @unique
  // The page to open (link) or the QR image to render (QR).
  url         String
  amountCents Int
  status      PaymentLinkStatus @default(CREATED)
  expiresAt   DateTime?
  // Who it was addressed to — a mobile number or email, for the record.
  sentTo      String?
  createdBy   String?
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_links")
}
