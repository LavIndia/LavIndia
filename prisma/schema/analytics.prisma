// =========================================================================
// ANALYTICS
//
// Owns engagement measurement. Append-only and side-effect free: nothing
// here is a source of truth for any other domain.
// =========================================================================

// ---------------------------------------------------------
// Product engagement analytics (real, admin-visible: see
// Admin > Analytics > Product Engagement) — not a stub.
// ---------------------------------------------------------
enum ProductEventType {
  VIEW
  ADD_TO_CART
}

model ProductEvent {
  id         String           @id @default(cuid())
  type       ProductEventType
  // Anonymous per-browser-session id (a client-generated UUID kept in
  // sessionStorage), NOT a user id — this tracks engagement for both
  // signed-in and anonymous shoppers without needing an account.
  sessionId  String
  // Only set for VIEW events: how long the product page stayed visible,
  // measured client-side and sent via sendBeacon on unload/tab-hide.
  durationMs Int?
  createdAt  DateTime         @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("product_events")
}
