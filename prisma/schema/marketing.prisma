// =========================================================================
// MARKETING DOMAIN
//
// Owns the merchandising surfaces: banners, coupons, homepage composition
// and the price-tier entry points. It reads the catalog but never writes
// to it.
// =========================================================================

// ---------------------------------------------------------
// Discounts and Coupons
// ---------------------------------------------------------
model Discount {
  id            String   @id @default(cuid())
  code          String   @unique
  title         String
  description   String?
  discountType  String // PERCENTAGE, FIXED_AMOUNT
  discountValue Int // percentage (10 = 10%) or fixed amount in paisa
  minPurchase   Int? // minimum purchase amount in paisa
  maxDiscount   Int? // maximum discount amount in paisa (for percentage type)
  startDate     DateTime // overall campaign window the recurrence (if any) is bounded by
  endDate       DateTime
  isActive      Boolean  @default(true)
  usageLimit    Int? // null = unlimited
  usedCount     Int      @default(0)

  // Recurring activation: the coupon is only live during startDate..endDate
  // AND, when isRecurring is true, only on the matching recurrence slice.
  isRecurring          Boolean @default(false)
  recurrenceType       String? // "DAILY" | "WEEKLY" | "MONTHLY"
  recurrenceDaysOfWeek Int[]   @default([]) // WEEKLY: 0=Sun..6=Sat
  recurrenceDayOfMonth Int? // MONTHLY: 1-31
  recurrenceStartTime  String? // "HH:MM" 24h — optional time-of-day window
  recurrenceEndTime    String? // "HH:MM" 24h

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discounts")
}

// ---------------------------------------------------------
// Hero Banners for homepage
// ---------------------------------------------------------
model HeroBanner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  imagePath String
  // Optional portrait artwork for phones. A 16:9 banner cover-cropped into a
  // phone's near-square hero frame keeps barely half its width, which cuts
  // the wordmark and the call to action off a composed banner. When this is
  // set the storefront shows it below the `md` breakpoint; when it is not,
  // the landscape image is used at every width exactly as before.
  mobileImagePath String?
  linkUrl   String?
  order     Int     @default(0)
  active    Boolean @default(true)

  // Optional scheduling — same convention/logic as Discount and
  // PromoBanner (see src/lib/scheduling.ts). Null dates = no bound.
  startDate            DateTime?
  endDate              DateTime?
  isRecurring          Boolean   @default(false)
  recurrenceType       String?
  recurrenceDaysOfWeek Int[]     @default([])
  recurrenceDayOfMonth Int?
  recurrenceStartTime  String?
  recurrenceEndTime    String?

  createdAt DateTime @default(now())

  @@map("hero_banners")
}

// ---------------------------------------------------------
// Promotional Banners (Top scroll, Free gifts, etc.)
// ---------------------------------------------------------
model PromoBanner {
  id        String    @id @default(cuid())
  type      String // 'top_scroll', 'free_gifts', 'special_offer'
  title     String?
  message   String
  bgColor   String? // Background color or gradient
  textColor String?
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  // See src/lib/scheduling.ts — same recurrence convention as Discount/HeroBanner.
  isRecurring          Boolean @default(false)
  recurrenceType       String?
  recurrenceDaysOfWeek Int[]   @default([])
  recurrenceDayOfMonth Int?
  recurrenceStartTime  String?
  recurrenceEndTime    String?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_banners")
}

// ---------------------------------------------------------
// Budget Tiers for Shop Under Budget Section
// ---------------------------------------------------------
model BudgetTier {
  id        String   @id @default(cuid())
  title     String
  maxPrice  Int // in paisa
  gradient  String // CSS gradient string
  icon      String? // Optional icon name
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_tiers")
}

// ---------------------------------------------------------
// Homepage Section Visibility & Order
// ---------------------------------------------------------
model HomePageSection {
  id        String   @id @default(cuid())
  name      String   @unique // 'hero', 'explore', 'bestsellers', 'budget', 'free_gifts', 'new_arrivals', 'trust_badges', 'coupons'
  title     String? // Override default title
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

// ---------------------------------------------------------
// Newsletter
// ---------------------------------------------------------
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------
// Editorial and policy pages
// ---------------------------------------------------------
// The storefront's written pages — the story, the core values, the FAQ and
// the four policies. They live in the database so that an admin can correct
// a return window or a support hour without a deploy, which matters most for
// exactly the pages that carry legal commitments.
//
// A row here is an override. Every page ships with a default draft in
// src/content/, and the reader falls back to that draft whenever no row
// exists, so the storefront renders correctly on a database that has never
// been edited.
model ContentPage {
  slug  String  @id // matches the public URL, e.g. "privacy-policy"
  title String
  intro String? // one sentence under the title; hidden when empty

  // Shown as "Last updated ..." — free text so the wording can match the
  // page ("March 2026", "20 September 2026"). Policy pages carry one.
  lastUpdated String?

  // ContentSection[]: { heading, body?: string[], bullets?: string[] }.
  // Held as JSON because a section is only ever read and written whole, as
  // part of its page, and is never queried or joined across pages.
  sections Json

  isPublished Boolean @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?
  createdAt   DateTime @default(now())

  @@map("content_pages")
}

/// A moment worth showing off: an expo stand, a pop-up, an award, a press
/// mention. Deliberately not tied to the catalogue — a highlight is about
/// the house rather than about a piece — and deliberately media-typed from
/// the start, so the same band can carry film once there is film to carry.
model Highlight {
  id          String  @id @default(cuid())
  title       String
  description String?

  /// Where it happened, e.g. "IIJS Premiere, Mumbai". Shown only when set.
  place String?
  /// When it happened. Only the date is ever displayed.
  happenedOn DateTime?
  /// A short word for the card's tag, e.g. "Expo", "Pop-up", "Award".
  kind String?

  /// "IMAGE" or "VIDEO" — see the marketing module's HighlightMediaType.
  mediaType String @default("IMAGE")
  mediaUrl  String
  /// The still shown before a film plays. Ignored for an image.
  posterUrl String?

  /// Where the card leads, if anywhere.
  linkUrl String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("highlights")
}
