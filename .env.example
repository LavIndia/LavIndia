# Supabase (Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Auth: set this to the deployed site URL in Vercel, not localhost.
NEXTAUTH_URL=https://your-production-domain.example
AUTH_TRUST_HOST=true

# ImageKit (public assets and uploads)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-server-only-private-key
IMAGEKIT_ENABLED=true

# Prisma
DATABASE_URL=postgresql://postgres.project-ref:password@pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project-ref:password@db.project-ref.supabase.co:5432/postgres

# Secret for scheduled jobs. The reservation sweeper endpoint refuses to
# run without it, so an abandoned checkout would strand its stock.
CRON_SECRET="change-me"
